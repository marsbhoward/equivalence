# Cardano Preview testnet by default - see README before ever pointing this at Mainnet.
BLOCKFROST_API_KEY=previewXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BLOCKFROST_URL=https://cardano-preview.blockfrost.io/api/v0
NETWORK=Preview

# Optional - defaults to Pinata's public gateway. ipfs.io itself, and the gateways that just
# redirect to it, rate-limit anonymous requests hard enough to break the showcase; see blockfrost.ts.
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# BIP-39 seed phrase for the project/service wallet. Real secret - never commit a filled-in
# .env, never log this value, never send it anywhere but Lucid's own wallet.fromSeed().
SERVICE_WALLET_SEED=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

PORT=8787
